{
  // 새 프로젝트는 Pages가 아니라 Workers + static assets로 시작하라는 것이
  // Cloudflare 공식 문서의 권장이라 이쪽을 택했다. 정적 파일과 API를 한 번에 배포한다.
  "name": "fransis-hangout",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  // 기본 주소(workers.dev)로만 연다. 버전마다 따로 생기는 미리보기 주소는 비공개 사이트에
  // 접근 경로만 늘리므로 끈다.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // /p/<조사 id> 같은 주소를 열어도 index.html을 돌려줘서 화면이 뜨게 한다.
    "not_found_handling": "single-page-application",
    // /api/* 만 Worker가 먼저 받고, 나머지는 정적 파일이 먼저 응답한다.
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fransis-hangout-db",
      "migrations_dir": "migrations"
    }
  ]
}
